{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "maxDuration": 120,
      "includeFiles": "{config/**,radar/**,nazar/**}",
      "excludeFiles": "{data/**,.github/**,**/__pycache__/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/heartbeat",
      "schedule": "0 4 * * *"
    }
  ]
}
