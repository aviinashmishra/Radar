# Copy to .env and fill in. Everything is optional: the radar runs without any key
# (heuristic scoring, console alerts). Add keys to unlock the AI layer and push alerts.

# Claude API - classification, importance scoring, "so what" counter-moves, weekly brief, Ask-the-Radar chat
ANTHROPIC_API_KEY=
RADAR_MODEL=claude-opus-5-5

# Gemini API - same jobs as Claude (scoring, briefs, chat, screenshot vision). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Which AI to use: auto (Claude if its key is set, else Gemini) | claude | gemini | off
RADAR_AI_PROVIDER=auto

# Telegram alerts (create a bot with @BotFather, then message it once and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord / Slack incoming webhook (optional, same message goes here too)
WEBHOOK_URL=

# Meta Ad Library (optional) - https://www.facebook.com/ads/library/api  needs a Meta app access token
META_ACCESS_TOKEN=

# Minimum importance (1-10) an event needs before it is pushed as an alert
ALERT_THRESHOLD=6

# Where the SQLite database lives
RADAR_DB=data/radar.db

# SEC EDGAR (financials of US-listed parents: Garmin, Zepp Health / Amazfit, Alphabet / Fitbit) asks every automated
# client to identify itself with a contact address. Any address you own works; the radar makes three small requests a day.
SEC_CONTACT=

# Email digest (optional). Daily/weekly briefs are emailed when all of these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Password for the dashboard (the browser asks; any user name). Set it whenever others can reach the server.
RADAR_PASSWORD=

# Pebble's own sales (optional). A Shopify custom app's Admin API access token with read_orders pulls orders every hour
# into the sales table (daily / weekly / monthly / yearly reports, region map). SHOPIFY_STORE only if the admin host differs
# from the storefront (name.myshopify.com). Without it, import CSVs on the Reports page.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_STORE=

# ---- Cloud mode only (set these in the Vercel project, not here) ----
# GITHUB_TOKEN=      fine-grained, this repo, Actions: Read and write (Run button), + Contents: Read if private
# CRON_SECRET=       lets the daily heartbeat warn you and restart the worker when data goes stale
# RADAR_REPO=        owner/name, only for a fork (default: cloud_repo in config/competitors.yaml)
